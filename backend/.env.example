# ==============================================================================
# Olivelas SmartPages (AIOps OpsPages) — Backend Template (backend/.env.example)
# ==============================================================================

PROJECT_NAME="Olivelas SmartPages — Static Hosting & Governance"
VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

OPSPAGES_JWT_SECRET="change-me-in-production"
OPSPAGES_JWT_EXPIRE_MINUTES=480

# Supabase Credentials
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<sb_publishable_or_anon_key>
db_host=db.<project-ref>.supabase.co
db_port=5432
db=postgres
db_username=postgres
db_password=<your-db-password>
DB_SCHEMA=smartpages

# Policy: The very first user registered on the platform becomes Global Admin
FIRST_USER_IS_GLOBAL_ADMIN=true

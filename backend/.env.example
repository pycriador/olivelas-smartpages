# ==============================================================================
# AIOps OpsPages — Backend Configuration (.env.example)
# ==============================================================================

PROJECT_NAME="AIOps OpsPages"
VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security & JWT
SECRET_KEY="CHANGE_ME_TO_A_32_BYTE_RANDOM_HEX_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# DATABASE ENGINE CONFIGURATION (SQLite, PostgreSQL, or MariaDB/MySQL)
# ==============================================================================
# Option 1: SQLite (Default for immediate local execution)
OPSPAGES_META_DB_URL="sqlite:///./opspages_meta.db"

# Option 2: PostgreSQL
# OPSPAGES_META_DB_URL="postgresql+psycopg://postgres:password@localhost:5432/aiops_opspages"

# Option 3: MariaDB / MySQL
# OPSPAGES_META_DB_URL="mysql+pymysql://root:password@localhost:3306/aiops_opspages?charset=utf8mb4"

# Optional discrete DB connection parameters (used if OPSPAGES_DB_ENGINE is set to postgresql or mariadb)
OPSPAGES_DB_ENGINE="sqlite"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="aiops_opspages"

# Default Super Admin Seed
DEFAULT_SUPERADMIN_EMAIL="willian.jesus@loft.com.br"
DEFAULT_SUPERADMIN_USERNAME="willian.jesus"
DEFAULT_SUPERADMIN_NAME="Willian Jesus"
DEFAULT_SUPERADMIN_PASSWORD="CHANGE_ME_BEFORE_RUNNING_SETUP_DB"

# Git & Static Repositories Storage Path
REPOS_STORAGE_DIR="../repos"

# Default Project Quotas
DEFAULT_MAX_BUILD_SIZE_MB=250
DEFAULT_MAX_STORAGE_MB=2048
DEFAULT_MAX_DEPLOYS_PER_DAY=100
DEFAULT_MAX_RETAINED_VERSIONS=50

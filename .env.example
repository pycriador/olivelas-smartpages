# ==============================================================================
# AIOps OpsPages — Exemplo de Configuração de Ambiente (.env.example)
# Copie para .env e preencha os segredos antes de iniciar em produção.
# NUNCA versione o arquivo .env real no Git.
# ==============================================================================

PROJECT_NAME="AIOps OpsPages"
VERSION="1.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Portas de Execução (usadas pelo ./start.sh)
OPSPAGES_BACKEND_PORT=8005
OPSPAGES_FRONTEND_PORT=5176

# Segurança & JWT
SECRET_KEY="<GERE_UMA_CHAVE_ALEATORIA_DE_64_BYTES>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de Metadados (sqlite | postgresql | mariadb)
OPSPAGES_DB_ENGINE="sqlite"
OPSPAGES_META_DB_URL="sqlite:///./opspages_meta.db"
# Exemplos para outros bancos:
# OPSPAGES_DB_ENGINE="postgresql"
# OPSPAGES_META_DB_URL="postgresql+psycopg://postgres:<SENHA>@localhost:5432/aiops_opspages"
# OPSPAGES_DB_ENGINE="mariadb"
# OPSPAGES_META_DB_URL="mysql+pymysql://root:<SENHA>@localhost:3306/aiops_opspages?charset=utf8mb4"

# Diretório Físico dos Repositórios Git de Builds (/repos)
REPOS_STORAGE_DIR="../repos"

# Super Admin Padrão (Bootstrap inicial via .env)
DEFAULT_SUPERADMIN_EMAIL="willian.jesus@loft.com.br"
DEFAULT_SUPERADMIN_USERNAME="willian.jesus"
DEFAULT_SUPERADMIN_NAME="Willian Jesus"
DEFAULT_SUPERADMIN_PASSWORD="<DEFINA_A_SENHA_DO_SUPERADMIN_NO_ENV>"

# Quotas Padrão por Projeto
DEFAULT_MAX_BUILD_SIZE_MB=250
DEFAULT_MAX_STORAGE_MB=2048
DEFAULT_MAX_DEPLOYS_PER_DAY=100
DEFAULT_MAX_RETAINED_VERSIONS=50

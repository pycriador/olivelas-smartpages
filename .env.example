# ==============================================================================
# Olivelas SmartPages (AIOps OpsPages) — Environment Template (.env.example)
# ==============================================================================

# Supabase Frontend & API Configuration
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<sb_publishable_or_anon_key>
VITE_SUPABASE_SCHEMA=smartpages

# Supabase PostgreSQL Database Connection
db_host=db.<project-ref>.supabase.co
db_port=5432
db=postgres
db_username=postgres
db_password=<your-db-password>

# Isolated PostgreSQL Schema for this project
DB_SCHEMA=smartpages

# Backend JWT & Runtime Settings
OPSPAGES_JWT_SECRET=change-this-secret-in-production
OPSPAGES_JWT_EXPIRE_MINUTES=480
